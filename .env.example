# Football
#
# Leave the public values empty to run the local demo (role picker, data in this browser only).
# `npm run build` does not need these secrets.
# When both public values are set, auth mode becomes supabase unless you force demo.

# NEXT_PUBLIC_AUTH_MODE=demo
# NEXT_PUBLIC_AUTH_MODE=supabase

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC_.
# Club reads and writes use the signed-in user so row level security applies.
# The service role is optional and is not required for the app screens.
# SUPABASE_SERVICE_ROLE_KEY=
